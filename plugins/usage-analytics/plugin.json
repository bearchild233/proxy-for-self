{
  "id": "usage-analytics",
  "version": "0.3.5",
  "protocol": 2,
  "kind": "ui",
  "sdk": 1,
  "pages": [
    {
      "id": "dashboard",
      "title": "概览",
      "entry": "ui/module.js",
      "roles": [
        "admin"
      ],
      "route": "/"
    },
    {
      "id": "usage",
      "title": "使用统计",
      "entry": "ui/module.js",
      "roles": [
        "admin"
      ],
      "route": "/usage"
    },
    {
      "id": "key-usage",
      "title": "我的用量",
      "entry": "ui/module.js",
      "roles": [
        "key"
      ],
      "route": "/key-usage"
    }
  ],
  "capabilities": [
    "account-groups.get.admin.account-groups",
    "accounts.get.admin.accounts",
    "accounts.get.admin.accounts.detail",
    "accounts.get.admin.accounts.export",
    "accounts.get.admin.accounts.import-tasks",
    "accounts.get.admin.accounts.import-tasks.detail",
    "accounts.get.admin.accounts.models",
    "accounts.get.admin.accounts.personal-info",
    "accounts.get.admin.accounts.quota-forecast",
    "accounts.get.admin.accounts.reset-credits",
    "api-keys.get.admin.client-keys",
    "api-keys.get.admin.client-keys.reveal",
    "api-keys.post.admin.client-keys.bindings",
    "auth.get.auth.status",
    "auth.post.auth.logout",
    "dashboard.get.admin.dashboard.summary",
    "dashboard.get.admin.dashboard.trend",
    "key-usage.get.key-usage.config",
    "key-usage.get.key-usage.overview",
    "key-usage.get.key-usage.records",
    "key-usage.get.key-usage.version",
    "usage.get.admin.operations.errors",
    "usage.get.admin.usage.insights.diagnostics",
    "usage.get.admin.usage.insights.key-account",
    "usage.get.admin.usage.insights.overview",
    "usage.get.admin.usage.records",
    "usage.get.admin.usage.records.detail",
    "usage.get.admin.usage.records.summary"
  ],
  "releasedAt": "2026-10-13T12:30:00Z",
  "releaseNotes": [
    "错误排查的账号列与详情：名称在上、邮箱在下，不再只显示邮箱。",
    "消耗明细优先显示当前账号名称，邮箱作为次级信息，不展示账号引用 ID。",
    "图表、使用记录及请求详情统一按名称和邮箱展示账号。",
    "归档账号保留名称；目录读取失败时保留现有展示，避免触发上游刷新。"
  ],
  "runtime": "vue-component",
  "hostApi": 1
}
