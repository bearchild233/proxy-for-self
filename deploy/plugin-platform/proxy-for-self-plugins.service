[Unit]
Description=proxy-for-self plugin control plane
After=network-online.target
Wants=network-online.target
[Service]
User=proxy-for-self-plugins
Group=proxy-for-self-plugins
# Set supplementary updater socket group in a deployment-specific drop-in.
WorkingDirectory=/opt/proxy-for-self/platform-current
ExecStart=/usr/bin/python3 -I services/plugin_host/server.py serve --root /var/lib/proxy-for-self/plugins --gateway-port 8080 --port 18335 --origin https://api.example.com --updater-socket /run/proxy-for-self-updater/control.sock
Restart=on-failure
RestartSec=3
TimeoutStopSec=100
MemoryHigh=160M
MemoryMax=256M
TasksMax=80
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/proxy-for-self/plugins
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
