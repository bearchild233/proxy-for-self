{
  "id": "account-warmup",
  "version": "0.2.0",
  "protocol": 2,
  "kind": "ui",
  "sdk": 1,
  "runtime": "vue-component",
  "hostApi": 1,
  "pages": [
    {"id": "main", "title": "自动预热", "entry": "ui/module.js", "roles": ["admin"], "route": "/extensions/account-warmup"}
  ],
  "capabilities": [
    "account-warmup.read",
    "account-warmup.configure",
    "account-warmup.run",
    "account-warmup.history",
    "account-warmup.cancel",
    "accounts.get.admin.accounts"
  ],
  "service": {
    "binary": "service/account-warmup",
    "kernelApi": {"major": 0, "minMinor": 8},
    "capabilities": ["accounts.warmup.read", "accounts.warmup.run", "log"],
    "fetchHosts": [],
    "memoryMax": "64M",
    "shutdownSeconds": 30
  },
  "releasedAt": "2026-10-30T00:00:00+08:00",
  "releaseNotes": [
    "账号页显示当前窗口预热状态，支持逐账号手动预热。",
    "支持自定义提示词和推理强度，手动参数只影响本次任务。",
    "自动预热独立设置，遵守停用、额度与养号限制；未知发送结果不自动重试。"
  ]
}
