{
  "release_root": "/opt/api-hub",
  "service": "api-hub.service",
  "initial_version": "0.1.0",
  "socket": "/run/proxy-for-self-updater/control.sock",
  "socket_group": "api-hub",
  "state_file": "/var/lib/proxy-for-self-updater/state.json",
  "backup_root": "/root/backups/proxy-for-self-updates",
  "config_directory": "/etc/api-hub",
  "health_url": "http://127.0.0.1:8320/healthz",
  "database": {
    "host": "127.0.0.1",
    "port": 18321,
    "name": "api_hub",
    "user": "api_hub_bootstrap",
    "pgpass_file": "/etc/proxy-for-self/updater.pgpass"
  },
  "service_plugins": {
    "registry_file": "/etc/proxy-for-self/plugin-registry.json",
    "store_root": "/var/lib/proxy-for-self/plugins/plugins",
    "runtime_root": "/opt/proxy-for-self-plugin-runtime",
    "socket_root": "/run/proxy-for-self-plugins",
    "data_root": "/var/lib/proxy-for-self-plugin-data",
    "env_directory": "/etc/proxy-for-self/plugin-services",
    "unit_directory": "/etc/systemd/system",
    "state_file": "/var/lib/proxy-for-self-updater/service-plugins.json",
    "user": "proxy-for-self-plugins",
    "group": "proxy-for-self-plugins",
    "allow": {
      "example-echo": {"grants": ["log"], "fetchHosts": []}
    }
  }
}
